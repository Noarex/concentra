}

# ---------- engeller ----------
dns_tazele() { mac && { dscacheutil -flushcache; killall -HUP mDNSResponder; } >/dev/null 2>&1; return 0; }

hosts_ekle() {
  local h
  [ "${#HOSTS_ADLAR[@]}" -gt 0 ] || return 0
  grep -q '^# odak-basla' "$HOSTS" && return 0
  {
    echo "# odak-basla"
    for h in "${HOSTS_ADLAR[@]}"; do echo "0.0.0.0 $h"; echo ":: $h"; done
    echo "# odak-bitis"
  } >> "$HOSTS"
  dns_tazele
}

hosts_sil() {
  local gecici
  grep -q '^# odak-basla' "$HOSTS" || return 0
  gecici=$(mktemp)
  awk '/^# odak-basla/{s=1} !s{print} /^# odak-bitis/{s=0}' "$HOSTS" > "$gecici" && cat "$gecici" > "$HOSTS"
  rm -f "$gecici"
  dns_tazele
}

pf_kur() {
  local kurallar=() ip
  if evet_mi "$TAILSCALE_ENGELLE"; then
    kurallar+=("block drop out quick inet to 100.64.0.0/10" "block drop out quick inet6 to fd7a:115c:a1e0::/48")
  fi
  for ip in "${ENGELLI_IPLER[@]}"; do
    if [[ "$ip" == *:* ]]; then kurallar+=("block drop out quick inet6 to $ip")
    else kurallar+=("block drop out quick inet to $ip"); fi
  done
  if [ "${#kurallar[@]}" -eq 0 ]; then pf_kaldir; return; fi
  [ -n "$(pfctl -a "$PF_ANCHOR" -s rules 2>/dev/null)" ] && return
  # ana kural seti com.apple/* capasini icermiyorsa sistemin pf.conf'unu yukle
  pfctl -s Anchors 2>/dev/null | grep -q 'com.apple' || pfctl -f /etc/pf.conf >/dev/null 2>&1
  printf '%s\n' "${kurallar[@]}" | pfctl -a "$PF_ANCHOR" -f - >/dev/null 2>&1
  pfctl -e >/dev/null 2>&1 || true
}

pf_kaldir() {
  [ -n "$(pfctl -a "$PF_ANCHOR" -s rules 2>/dev/null)" ] && pfctl -a "$PF_ANCHOR" -F rules >/dev/null 2>&1
  return 0
}

ag_kur()     { if mac; then pf_kur; else nft_kur; fi; }
ag_kaldir()  { if mac; then pf_kaldir; else nft delete table inet odak 2>/dev/null || true; fi; }

nft_kur() {
  local ip
  if ! evet_mi "$TAILSCALE_ENGELLE" && [ "${#ENGELLI_IPLER[@]}" -eq 0 ]; then
    nft delete table inet odak 2>/dev/null || true; return
  fi
  nft list table inet odak >/dev/null 2>&1 && return
  nft add table inet odak
  nft add chain inet odak cikis '{ type filter hook output priority 0; policy accept; }'
  evet_mi "$TAILSCALE_ENGELLE" && nft add rule inet odak cikis oifname "tailscale0" drop
  for ip in "${ENGELLI_IPLER[@]}"; do
    if [[ "$ip" == *:* ]]; then nft add rule inet odak cikis ip6 daddr "$ip" drop
    else nft add rule inet odak cikis ip daddr "$ip" drop; fi
  done
}

uygula() {
  local liste="" ff="" s d f h

  # Chromium / Brave / Chrome (degisikligi kendileri fark eder)
  for s in "${SITELER[@]}"; do liste+="\"$s\","; done
  evet_mi "$YT_ABONELIK_ENGELLE" && liste+="\"$YT_YOL\","
  liste="[${liste%,}]"
  for d in "${CHROMIUM_DIRLER[@]}"; do
    mkdir -p "$d"; f="$d/odak.json"
    kilit_ac "$f"
    # gizli pencere ve Tor penceresi odak sirasinda kapali (eklenti ve hosts orada calismiyor)
    printf '{ "URLBlocklist": %s, "IncognitoModeAvailability": 1, "TorDisabled": true }\n' "$liste" > "$f"
    kilitle "$f"
  done

  # Firefox (tarayici yeniden acilinca devreye girer)
  if ! mac; then
  for s in "${SITELER[@]}"; do ff+="\"*://*.$s/*\","; done
  evet_mi "$YT_ABONELIK_ENGELLE" && ff+="\"*://*.youtube.com/feed/subscriptions*\","
  mkdir -p "$FIREFOX_DIR"
  if [ -f "$FIREFOX_DOSYA" ] && [ ! -f "$FIREFOX_ISARET" ] && [ ! -f "$FIREFOX_DOSYA.odak-yedek" ]; then
    cp "$FIREFOX_DOSYA" "$FIREFOX_DOSYA.odak-yedek"
  fi
  kilit_ac "$FIREFOX_DOSYA"
  printf '{ "policies": { "WebsiteFilter": { "Block": [%s] }, "DisablePrivateBrowsing": true } }\n' "${ff%,}" > "$FIREFOX_DOSYA"
  kilitle "$FIREFOX_DOSYA"
  touch "$FIREFOX_ISARET"
  fi

  # /etc/hosts: her tarayicida aninda calisir
  hosts_ekle

  # Engel yeni devreye giriyorsa tarayicilari kapat (sekmeler yeniden acilinca engellenir)
  if [ ! -f "$ENGEL_ISARET" ]; then
    mkdir -p "$DIR"; touch "$ENGEL_ISARET"
    for h in "${TARAYICILAR[@]}"; do pkill -ix "$h" 2>/dev/null || true; done
  fi

  eklenti_yaz true
  for h in "${UYGULAMALAR[@]}"; do pkill -ix "$h" 2>/dev/null || true; done
  mac && brave_bekci
  ag_kur
}

engelleri_kaldir() {
  local d f
  rm -f "$ENGEL_ISARET"
  eklenti_yaz false
  for d in "${CHROMIUM_DIRLER[@]}"; do
    f="$d/odak.json"; [ -e "$f" ] && dosya_sil "$f"
  done
  # Firefox dosyasina sadece bizim yazdigimizsa dokun
  if [ -f "$FIREFOX_ISARET" ]; then
    kilit_ac "$FIREFOX_DOSYA"
    if [ -f "$FIREFOX_DOSYA.odak-yedek" ]; then mv -f "$FIREFOX_DOSYA.odak-yedek" "$FIREFOX_DOSYA"
    else rm -f "$FIREFOX_DOSYA"; fi
    rm -f "$FIREFOX_ISARET"
  fi
  hosts_sil
  ag_kaldir
}

# ---------- zamanlayici ve talepler ----------
# macOS'ta launchd servisi hep calisir (kontrol ucuz), Linux'ta sadece gerektiginde
zamanlayiciyi_ac()    { mac || systemctl enable --now "$ZAMANLAYICI" >/dev/null 2>&1 || true; }
zamanlayiciyi_kapat() { mac || systemctl disable --now "$ZAMANLAYICI" >/dev/null 2>&1 || true; }

talep_isle() {
  local islem zaman gun
  if [ -f "$ARA" ] && ! duraklatildi; then dosya_sil "$ARA"; logger "concentra: plan duraklamasi bitti"; fi
  [ -f "$TALEP" ] || return 0
  read -r islem zaman gun < "$TALEP"
  [ "$(simdi)" -ge "$zaman" ] || return 0
  case "$islem" in
    kapat) dosya_sil "$PLAN"; dosya_sil "$ARA"; dosya_sil "$PLAN_BASLANGIC" ;;
    ara)   yaz $(( zaman + gun * 86400 )) "$ARA" ;;
    hafta) yaz hafta "$PLAN" ;;
  esac
  dosya_sil "$TALEP"
  logger "concentra: talep uygulandi ($islem)"
}

talep_aciklama() {
  local islem zaman gun
  read -r islem zaman gun < "$TALEP"
  case "$islem" in
    kapat) echo "Bekleyen talep: plan kapanacak (tarih: $(tarih "$zaman"))." ;;
    ara)   echo "Bekleyen talep: plan $gun gun duraklayacak (duraklama: $(tarih "$zaman"), devam: $(tarih $(( zaman + gun * 86400 )))).";;
    hafta) echo "Bekleyen talep: plan hafta moduna gececek ($(gun_adlari "$HAFTA_GUNLER"); tarih: $(tarih "$zaman"))." ;;
  esac
  echo "Geri almak icin: odak plan vazgec"
}

talep_olustur() {   # $1=islem $2=gun(ara icin) $3=aciklama
  local z
  if [ -f "$TALEP" ]; then echo "Zaten bekleyen bir talep var."; talep_aciklama; exit 1; fi
  z=$(( $(simdi) + BEKLEME_GUN * 86400 ))
  echo "$3"
  echo "Bu talep $BEKLEME_GUN gun bekler, o zamana kadar plan aynen devam eder (tarih: $(tarih "$z"))."
  onay
  yaz "$1 $z ${2:-}" "$TALEP"
  talep_aciklama
}

kontrol() {
  mkdir -p "$DIR"
  mac && mac_eklenti_kopyala
  talep_isle
  if [ -f "$BITIS" ] && ! elle_aktif; then
    dosya_sil "$BITIS"; logger "concentra: tek seferlik odak bitti"
  fi
  find "$DIR" -maxdepth 1 -name 'ek-*' ! -name "ek-$(date +%F)" -delete 2>/dev/null
  if [ -f "$PLAN_BASLANGIC" ] && ! plan_bekliyor; then dosya_sil "$PLAN_BASLANGIC"; logger "concentra: plan basladi"; fi

  if aktif; then
    if molada; then engelleri_kaldir; else dosya_sil "$MOLA"; uygula; fi
  else
    dosya_sil "$MOLA"
    engelleri_kaldir
    [ -n "$(plan_modu)" ] || zamanlayiciyi_kapat
  fi
}

# ---------- kurulum / kaldirma (paket scriptletleri cagirir) ----------
eski_kurulumdan_tasi() {
  local f u ip
  # Eski elle kurulum: /usr/local/bin/odak + /var/lib/odak
  if [ -d /var/lib/odak ] && [ ! -e "$DIR/plan" ] && [ ! -e "$DIR/bitis" ]; then
    echo "concentra: eski kurulumdaki durum /var/lib/odak -> $DIR tasiniyor"
    mkdir -p "$DIR"
    for f in /var/lib/odak/*; do [ -e "$f" ] || continue; kilit_ac "$f"; cp -a "$f" "$DIR/"; kilitle "$DIR/$(basename "$f")"; done
    for f in /var/lib/odak/*; do [ -e "$f" ] && dosya_sil "$f"; done
    rmdir /var/lib/odak 2>/dev/null || true
  fi
  if [ -f /usr/local/bin/odak ] && grep -q "EKLENTI_ID=\"$EKLENTI_ID\"" /usr/local/bin/odak; then
    ip=$(sed -n 's/^HOST_IP="\([^"]*\)".*/\1/p' /usr/local/bin/odak)
    if [ -n "$ip" ] && [ ! -f "$CONF_DIR/eski-kurulum.conf" ]; then
      mkdir -p "$CONF_DIR"
      printf '%s\n' "# Eski elle kurulumdan otomatik tasindi" "TAILSCALE_ENGELLE=evet" "ENGELLI_IPLER=($ip)" \
        "UYGULAMALAR+=(moonlight)" > "$CONF_DIR/eski-kurulum.conf"
      echo "concentra: eski ayarlar $CONF_DIR/eski-kurulum.conf dosyasina yazildi"
    fi
    rm -f /usr/local/bin/odak
    echo "concentra: eski /usr/local/bin/odak kaldirildi"
  fi
  [ -f /usr/local/share/odak/odak-yt.crx ] && rm -rf /usr/local/share/odak
  for u in /etc/systemd/system/odak-kontrol.timer /etc/systemd/system/odak-kontrol.service; do
    if [ -f "$u" ] && grep -q 'odak' "$u"; then
      systemctl disable --now odak-kontrol.timer >/dev/null 2>&1 || true
      rm -f "$u"
    fi
  done
  systemctl daemon-reload 2>/dev/null || true
}

mac_kur() {
  local bin ornek
  bin="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  mkdir -p "$DIR" "$CONF_DIR"
  ornek="$(dirname "$(readlink -f "$0")")/../share/concentra/concentra.conf"
  if [ ! -f "$CONF" ] && [ -f "$ornek" ]; then cp "$ornek" "$CONF"; echo "concentra: $CONF olusturuldu"; fi
  cat > "$LAUNCHD_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LAUNCHD_ETIKET</string>
  <key>ProgramArguments</key>
  <array><string>$bin</string><string>--kontrol</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/var/log/concentra.log</string>
</dict>
</plist>
PLIST
  chown root:wheel "$LAUNCHD_PLIST"; chmod 644 "$LAUNCHD_PLIST"
  launchctl bootout "system/$LAUNCHD_ETIKET" >/dev/null 2>&1 || true
  launchctl bootstrap system "$LAUNCHD_PLIST"
  echo "concentra: dakikalik kontrol servisi kuruldu ($LAUNCHD_ETIKET)"

  mac_eklenti_kopyala
  profil_yaz
  echo
  if profil_kurulu; then
    echo "concentra: Brave ayar profili zaten kurulu."
  else
    local u; u=$(konsol_kullanici) && launchctl asuser "$(id -u "$u")" sudo -u "$u" open "$PROFIL_DOSYA" >/dev/null 2>&1
    mac_profil_yardim
  fi
  echo
  mac_eklenti_yardim
}

kur() {
  local c
  if mac; then mac_kur; else eski_kurulumdan_tasi; fi
  # tasima yeni bir ayar dosyasi yazmis olabilir, yeniden oku
  if [ -d "$CONF_DIR" ]; then for c in "$CONF_DIR"/*.conf; do [ -f "$c" ] && . "$c"; done; fi
  kanallari_hazirla
  if [ -n "$(plan_modu)" ] || [ -f "$BITIS" ]; then zamanlayiciyi_ac; fi
  kontrol
}

# Paket kaldirilirken (pacman pre_remove) ya da tamamen_kaldir icinden: engelleri ve servisleri kaldirir
kaldir() {
  local d
  engelleri_kaldir
  for d in "${CHROMIUM_DIRLER[@]}"; do dosya_sil "$d/odak-eklenti.json"; done
  if mac; then
    launchctl bootout "system/$LAUNCHD_ETIKET" >/dev/null 2>&1 || true
    rm -f "$LAUNCHD_PLIST"
    profiles remove -identifier "$PROFIL_ID" >/dev/null 2>&1 \
      || echo "concentra: Brave profilini elle kaldir: System Settings > General > Device Management"
  else
    systemctl disable --now "$ZAMANLAYICI" >/dev/null 2>&1 || true
  fi
  # durum dosyalarinin kilidini ac (artik bir sey korumuyorlar, elle silinebilsinler)
  if [ -d "$DIR" ]; then
    if mac; then chflags -R noschg "$DIR" 2>/dev/null; else chattr -R -i "$DIR" 2>/dev/null; fi
  fi
  echo "concentra: engeller, tarayici politikalari ve dakikalik kontrol kaldirildi."
  return 0
}

kullanici_evi() {
  local u="${SUDO_USER:-}"
  [ -n "$u" ] && [ "$u" != root ] || return 1
  if mac; then dscl . -read "/Users/$u" NFSHomeDirectory 2>/dev/null | awk '{print $2}'
  else getent passwd "$u" | cut -d: -f6; fi
}

# odak kaldir: concentra'yi kurulmadan onceki haline dondurur (paket dahil)
tamamen_kaldir() {
  local ev yedek d dosyalar=()
  if elle_aktif; then
    echo "Odak suruyor (bitis: $(saat "$(cat "$BITIS")")). Kaldirmak icin bitmesini bekle."; exit 1
  fi
  if [ -n "$(plan_modu)" ]; then
    echo "Acik bir plan var: $(plan_adi "$(plan_modu)"). Once plani kapat: odak plan kapat ($BEKLEME_GUN gun bekler)."; exit 1
  fi
  ev=$(kullanici_evi) || ev=""
  yedek="${ev:-/root}/concentra-ayarlar-$(date +%F).tar.gz"
  cat <<EOF
concentra tamamen kaldirilacak:
  - butun engeller, tarayici politikalari ve YouTube eklentisi politikasi
  - dakikalik kontrol servisi$(mac && echo " ve Brave ayar profili")
  - durum klasoru ($DIR) ve ayarlar ($CONF, $CONF_DIR)
    Ayarlarin once yedeklenir: $yedek
  - concentra paketi ($(mac && echo "brew uninstall" || echo "pacman -R"))
EOF
  onay

  kaldir
  # ayarlari yedekle, sonra sil
  if [ -f "$CONF" ] || [ -n "$(ls -A "$CONF_DIR" 2>/dev/null)" ]; then
    [ -f "$CONF" ] && dosyalar+=(concentra.conf)
    [ -d "$CONF_DIR" ] && dosyalar+=(concentra.d)
    tar czf "$yedek" -C /etc "${dosyalar[@]}" 2>/dev/null \
      && { [ -n "$ev" ] && chown "$SUDO_USER" "$yedek"; echo "concentra: ayarlar yedeklendi: $yedek"; }
  fi
  rm -rf "$CONF" "$CONF.pacsave" "$CONF.pacnew" "$CONF_DIR"
  rm -rf "$DIR"
  # concentra'nin actigi bos politika klasorlerini temizle (icinde baska bir sey varsa dokunmaz)
  for d in "${CHROMIUM_DIRLER[@]}" "$FIREFOX_DIR"; do
    [ -d "$d" ] && rmdir -p --ignore-fail-on-non-empty "$d" 2>/dev/null
  done
  mac && rm -f /var/log/concentra.log
  echo "concentra: durum ve ayarlar silindi."

  if mac; then
    cat <<EOF

Brave'de elle yaptiklarin:
  - brave://extensions'tan "Odak YouTube"u kaldir (Remove).
  - Istersen Developer mode'u kapat.
EOF
    if [ -n "${SUDO_USER:-}" ] && command -v brew >/dev/null; then
      sudo -u "$SUDO_USER" -H brew uninstall concentra >/dev/null 2>&1 \
        && sudo -u "$SUDO_USER" -H brew untap noarex/concentra >/dev/null 2>&1
      echo "concentra: Homebrew paketi kaldirildi."
    else
      echo "Son adim: brew uninstall concentra && brew untap noarex/concentra"
    fi
  else
    echo "concentra: Brave'deki YouTube eklentisi, politika kalktigi icin kendiliginden silinir."
    if pacman -Q concentra >/dev/null 2>&1; then
      echo "concentra: paket kaldiriliyor..."
      exec pacman -R --noconfirm concentra
    fi
  fi
  exit 0
}

# ---------- komutlar ----------
yardim() {
  cat <<EOF
concentra $SURUM - odak modu

  odak 2 | odak 1.5 | odak 45dk   tek seferlik odak (en fazla 24 saat)
  odak hafta                      $(gun_adlari "$HAFTA_GUNLER"), $PLAN_BAS-$PLAN_BIT otomatik odak
  odak full                       $(gun_adlari "$FULL_GUNLER"), $PLAN_BAS-$PLAN_BIT otomatik odak
  odak full 3g | odak hafta yarin plani ileri bir tarihte baslatir (en fazla 30 gun)
  odak plan kapat                 $BEKLEME_GUN gun sonra plani kapatir
  odak plan ara <gun>             $BEKLEME_GUN gun sonra plani <gun> gun duraklatir (1-$ARA_MAX_GUN), sonra devam eder
  odak plan vazgec                bekleyen talebi geri alir
  odak plan devam                 duraklamayi hemen bitirir
  odak mola                       $MOLA_DK dk mola (suresi bitise eklenir)
  odak kanal                      YouTube izin listesi
  odak kanal ekle|sil @kanal      listeyi degistirir (sadece odak disinda)
  odak eklenti                    YouTube eklentisinin kurulumu ve durumu (macOS)
  odak durum                      durum
  odak kaldir                     concentra'yi tamamen kaldirir (odak ve plan kapaliyken)
  odak surum

Ayarlar: $CONF ve $CONF_DIR/*.conf
EOF
}

durum() {
  local mod kalan
  if elle_aktif; then
    kalan=$(( $(cat "$BITIS") - $(simdi) ))
    printf "Tek seferlik odak: kalan %d saat %d dakika (bitis: %s)\n" \
      $((kalan / 3600)) $((kalan % 3600 / 60)) "$(saat "$(cat "$BITIS")")"
  fi
  mod=$(plan_modu)
  if [ -n "$mod" ]; then
    echo "Plan: $(plan_adi "$mod"), $PLAN_BAS-$PLAN_BIT"
    plan_bekliyor && echo "Plan $(gun "$(cat "$PLAN_BASLANGIC")") gunu baslayacak (ilk engel saat $PLAN_BAS). Hemen baslatmak icin: odak $mod"
    plan_aktif && echo "Plan su an aktif. Bugunku bitis: $(saat "$(plan_bitis_bugun)")"
    duraklatildi && echo "Plan duraklatildi, kendiliginden devam edecek (tarih: $(tarih "$(cat "$ARA")")). Hemen devam: odak plan devam"
  fi
  [ -f "$TALEP" ] && talep_aciklama
  molada && echo "Su an moladasin. Mola bitisi: $(saat "$(cat "$MOLA")")"
  aktif || echo "Su an engel yok."
  if mac && [ -d "$HOME/Library/Application Support/BraveSoftware" ]; then
    [ "$(brave_eklenti_durumu "$HOME")" = tamam ] \
      || echo "Uyari: YouTube eklentisi Brave'de yuklu/acik degil, odak sirasinda Brave kapatilir. Kurulum: odak eklenti"
  fi
  return 0
}

mola() {
  local m ek=0
  aktif || { echo "Odak modu kapali, molaya gerek yok."; exit 0; }
  molada && { echo "Zaten moladasin. Mola bitisi: $(saat "$(cat "$MOLA")")"; exit 0; }

  m=$(( $(simdi) + MOLA_SN ))
  if elle_aktif; then
    yaz $(( $(cat "$BITIS") + MOLA_SN )) "$BITIS"
    echo "Tek seferlik odagin yeni bitisi: $(saat "$(cat "$BITIS")")"
  fi
  if plan_aktif; then
    [ -f "$(ek_dosya)" ] && ek=$(cat "$(ek_dosya)")
    yaz $(( ek + MOLA_SN )) "$(ek_dosya)"
    echo "Planin bugunku yeni bitisi: $(saat "$(plan_bitis_bugun)")"
  fi
  yaz "$m" "$MOLA"
  engelleri_kaldir
  echo "$MOLA_DK dakikalik mola basladi. Mola bitisi: $(saat "$m")"
}

baslat() {
  local sn yeni
  # sadece duz sayi kabul et: 3 | 1.5 | 45dk  (nan, inf, 0x10, 1e9 vb. reddedilir)
  [[ "$1" =~ ^[0-9]{1,4}([.][0-9]{1,3})?(dk)?$ ]] \
    || { echo "Gecerli bir sure gir (en fazla 24 saat). Ornek: odak 2 | odak 1.5 | odak 45dk. Komutlar: odak yardim"; exit 1; }
  case "$1" in
    *dk) sn=$(awk -v m="${1%dk}" 'BEGIN { if (m+0 <= 0 || m+0 > 1440) exit 1; printf "%d", m*60 }') ;;
    *)   sn=$(awk -v h="$1"     'BEGIN { if (h+0 <= 0 || h+0 > 24)   exit 1; printf "%d", h*3600 }') ;;
  esac || { echo "Gecerli bir sure gir (en fazla 24 saat). Ornek: odak 2 | odak 1.5 | odak 45dk"; exit 1; }

  yeni=$(( $(simdi) + sn ))
  if elle_aktif && [ "$(cat "$BITIS")" -ge "$yeni" ]; then
    echo "Zaten bundan daha uzun bir odak suresi var."; durum; exit 0
  fi

  echo "Bitis saati: $(saat "$yeni"). O saate kadar engellenecek:"
  engel_listesi
  echo "Sure dolmadan geri alinamaz, yeniden baslatsan bile. Mola icin: odak mola"
  onay

  yaz "$yeni" "$BITIS"
  zamanlayiciyi_ac
  kontrol
  echo "Odak modu basladi."
}

plan_ayarla() {
  local yeni="$1" gecikme="${2:-}" eski gun bas=""
  eski=$(plan_modu)

  # Ileri tarihli baslangic: odak full 3g | odak hafta yarin
  if [ -n "$gecikme" ]; then
    [ "$gecikme" = yarin ] && gecikme=1
    if ! [[ "$gecikme" =~ ^([0-9]{1,2})(g|d|gun)?$ ]] || [ "${BASH_REMATCH[1]}" -lt 1 ] || [ "${BASH_REMATCH[1]}" -gt 30 ]; then
      echo "Gun sayisi 1-30 arasi olmali. Ornek: odak $yeni 3g (3 gun sonra baslar) | odak $yeni yarin"; exit 1
    fi
    gun=$((10#${BASH_REMATCH[1]}))
    if [ -n "$eski" ]; then
      echo "Zaten acik bir plan var: $(plan_adi "$eski"). Ileri tarihli baslangic sadece plan yokken kurulur."; exit 1
    fi
    bas=$(date -d "today +$gun days 00:00" +%s)
  fi

  if [ "$eski" = "$yeni" ]; then
    if plan_bekliyor; then
      echo "Plan $(gun "$(cat "$PLAN_BASLANGIC")") gunu baslayacakti, simdi baslayacak."
      onay
      dosya_sil "$PLAN_BASLANGIC"; kontrol
      echo "Plan basladi."; durum; exit 0
    fi
    echo "Bu plan zaten acik."
    duraklatildi && echo "Plan duraklatilmis. Hemen devam etmek icin: odak plan devam"
    exit 0
  fi
  if [ "$eski" = full ] && [ "$yeni" = hafta ]; then
    baslamadan_gevsetme_yok
    talep_olustur hafta "" "Plan full'den hafta moduna gevsetilecek ($(gun_adlari "$HAFTA_GUNLER"))."
    exit 0
  fi

  if [ -n "$bas" ]; then
    echo "Otomatik plan: $(plan_adi "$yeni"), $(gun "$bas") gununden itibaren $PLAN_BAS-$PLAN_BIT arasi engellenecek:"
  else
    echo "Otomatik plan: $(plan_adi "$yeni"), $PLAN_BAS-$PLAN_BIT arasi engellenecek:"
  fi
  engel_listesi
  echo "Kapatmak ya da gevsetmek $BEKLEME_GUN gun bekleme gerektirir."
  onay

  if [ -n "$bas" ]; then yaz "$bas" "$PLAN_BASLANGIC"; else dosya_sil "$PLAN_BASLANGIC"; fi
  yaz "$yeni" "$PLAN"
  zamanlayiciyi_ac
  kontrol
  echo "Plan kuruldu."; durum
}

plan_kapat() {
  [ -n "$(plan_modu)" ] || { echo "Acik bir plan yok."; exit 0; }
  baslamadan_gevsetme_yok
  talep_olustur kapat "" "Otomatik plan tamamen kapatilacak."
}

plan_ara() {
  local gun="${1:-}"
  [ -n "$(plan_modu)" ] || { echo "Acik bir plan yok."; exit 0; }
  baslamadan_gevsetme_yok
  [[ "$gun" =~ ^[0-9]{1,2}$ ]] && [ "$gun" -ge 1 ] && [ "$gun" -le "$ARA_MAX_GUN" ] \
    || { echo "Gun sayisi 1-$ARA_MAX_GUN arasi olmali. Ornek: odak plan ara 7"; exit 1; }
  duraklatildi && { echo "Plan zaten duraklatilmis."; durum; exit 0; }
  talep_olustur ara "$gun" "Plan $gun gun duraklatilacak, sonra kendiliginden devam edecek."
}

plan_vazgec() {
  [ -f "$TALEP" ] || { echo "Bekleyen bir talep yok."; exit 0; }
  dosya_sil "$TALEP"
  echo "Talep geri alindi, plan oldugu gibi devam ediyor."
}

plan_devam() {
  duraklatildi || { echo "Plan duraklatilmamis."; exit 0; }
  dosya_sil "$ARA"
  kontrol
  echo "Plan hemen devam ediyor."; durum
}

case "${1:-}" in
  --kontrol)       kontrol ;;
  --kur)           kur ;;
  --kaldir)        kaldir ;;
  kaldir)          tamamen_kaldir ;;
  kanal)           kanal "${2:-}" "${3:-}" ;;
  eklenti)         eklenti_komutu ;;
  mola)            mola ;;
  hafta|full)      plan_ayarla "$1" "${2:-}" ;;
  plan)
    case "${2:-}" in
      kapat)  plan_kapat ;;
      ara)    plan_ara "${3:-}" ;;
      vazgec) plan_vazgec ;;
      devam)  plan_devam ;;
      *)      durum ;;
    esac ;;
  durum|"")        durum ;;
  yardim|help|-h|--help) yardim ;;
  surum|--version) echo "concentra $SURUM" ;;
  *)               baslat "$1" ;;
esac
