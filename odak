#!/usr/bin/env bash
# concentra / odak - planli odak modu
# Siteleri, uygulamalari ve YouTube'u (kanal izin listesiyle) belirli saatlerde engeller.
# Komutlar icin: odak yardim (GitHub: https://github.com/Noarex/concentra)
# Ayarlar: /etc/concentra.conf ve /etc/concentra.d/*.conf

set -uo pipefail
SURUM="1.4.1"

ISLETIM=$(uname -s)
mac() { [ "$ISLETIM" = Darwin ]; }
if mac; then
  # Homebrew GNU araclari once gelsin (date -d, sed vb. Linux'taki gibi calissin)
  for _p in /opt/homebrew /usr/local; do
    [ -d "$_p/opt/coreutils/libexec/gnubin" ] && PATH="$_p/opt/coreutils/libexec/gnubin:$_p/opt/gnu-sed/libexec/gnubin:$_p/bin:$PATH"
  done
  export PATH="$PATH:/usr/sbin:/sbin"
fi

# ---------- varsayilan ayarlar (/etc/concentra.conf bunlari degistirir) ----------
PLAN_BAS="07:30"
PLAN_BIT="20:00"
HAFTA_GUNLER="1 2 3 4 5"      # 1=Pazartesi ... 7=Pazar
FULL_GUNLER="1 2 3 4 5 6 7"
MOLA_DK=15
BEKLEME_GUN=3
ARA_MAX_GUN=14

SITELER=(twitch.tv kick.com x.com twitter.com instagram.com discord.com discord.gg discordapp.com)
HOSTS_ADLAR=(twitch.tv www.twitch.tv m.twitch.tv kick.com www.kick.com x.com www.x.com
             twitter.com www.twitter.com mobile.twitter.com instagram.com www.instagram.com
             discord.com www.discord.com ptb.discord.com canary.discord.com gateway.discord.gg
             discord.gg discordapp.com cdn.discordapp.com media.discordapp.net)
YT_ABONELIK_ENGELLE=evet
UYGULAMALAR=(Discord DiscordPTB DiscordCanary discord vesktop legcord webcord)
TARAYICILAR=(brave chromium chrome firefox "Brave Browser" "Google Chrome" Safari)
TAILSCALE_ENGELLE=hayir
ENGELLI_IPLER=()
VARSAYILAN_KANALLAR=(@ProfessorLeonard @TheOrganicChemistryTutor @3blue1brown @DrTrefor
                     @kristakingmath @patrickjmt @khanacademy @mitocw)

CONF=/etc/concentra.conf
CONF_DIR=/etc/concentra.d
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
if [ -d "$CONF_DIR" ]; then for _c in "$CONF_DIR"/*.conf; do [ -f "$_c" ] && . "$_c"; done; fi

# Okuma amacli komutlar root istemez, gerisi sudo ile kendini yeniden calistirir
case "${1:-}" in
  ""|durum|yardim|help|-h|--help|surum|--version|eklenti) ;;
  kanal) [ -n "${2:-}" ] && [ "$EUID" -ne 0 ] && exec sudo "$0" "$@" ;;
  *) [ "$EUID" -eq 0 ] || exec sudo "$0" "$@" ;;
esac

# ---------- sabit yollar ----------
if mac; then DIR=/var/db/concentra; else DIR=/var/lib/concentra; fi
BITIS="$DIR/bitis"      # tek seferlik odagin bitisi (epoch)
MOLA="$DIR/mola"        # molanin bitisi (epoch)
PLAN="$DIR/plan"        # "hafta" ya da "full"
TALEP="$DIR/talep"      # bekleyen talep: "<kapat|ara|hafta> <yururluk epoch> [gun]"
ARA="$DIR/ara"          # plan duraklamasinin bitisi (epoch)
PLAN_BASLANGIC="$DIR/plan-baslangic"   # ileri tarihli planin baslangici (epoch)
KANALLAR="$DIR/kanallar"
ENGEL_ISARET="$DIR/engel-acik"
FIREFOX_ISARET="$DIR/firefox-yazildi"
MOLA_SN=$(( MOLA_DK * 60 ))
ZAMANLAYICI=concentra.timer

YT_YOL="youtube.com/feed/subscriptions"
HOSTS=/etc/hosts
CHROMIUM_DIRLER=(/etc/chromium/policies/managed /etc/brave/policies/managed /etc/opt/chrome/policies/managed)
mac && CHROMIUM_DIRLER=()   # macOS'ta politikalar yapilandirma profiliyle gelir (asagida)
FIREFOX_DIR=/etc/firefox/policies
FIREFOX_DOSYA="$FIREFOX_DIR/policies.json"

# YouTube kanal izin listesi eklentisi (politika ile zorla kurulur, kapatilamaz)
EKLENTI_ID="mfekpjflnlikpeejlfcilhhdeonchfgh"
EKLENTI_DIR=/usr/share/concentra

# macOS
# Eklenti Brave'e elle "paketlenmemis" olarak yuklenir (Web Store disi eklentiyi zorla kurmak
# MDM gerektiriyor). Durumu durum.json'dan okur; odak sirasinda eklenti yuklu ve acik degilse
# Brave kapatilir.
MAC_EKLENTI="$DIR/eklenti"
MAC_EKLENTI_KAYNAK="$(dirname "$(readlink -f "$0")")/../share/concentra/eklenti"
BRAVE_SUREC="Brave Browser"
PROFIL_ID="com.noarex.concentra.brave"
PROFIL_DOSYA="$DIR/concentra-brave.mobileconfig"
PF_ANCHOR="com.apple/concentra"
LAUNCHD_ETIKET="com.noarex.concentra"
LAUNCHD_PLIST="/Library/LaunchDaemons/$LAUNCHD_ETIKET.plist"

# ---------- yardimcilar ----------
if mac; then
  kilitle()  { chflags schg "$1" 2>/dev/null || true; }
  kilit_ac() { [ -e "$1" ] && chflags noschg "$1" 2>/dev/null || true; }
else
  kilitle()  { chattr +i "$1" 2>/dev/null || true; }
  kilit_ac() { [ -e "$1" ] && chattr -i "$1" 2>/dev/null || true; }
fi
yaz()       { mkdir -p "$DIR"; kilit_ac "$2"; echo "$1" > "$2"; kilitle "$2"; }
dosya_sil() { kilit_ac "$1"; rm -f "$1"; }
saat()      { date -d @"$1" '+%H:%M'; }
AYLAR=(x Ocak Subat Mart Nisan Mayis Haziran Temmuz Agustos Eylul Ekim Kasim Aralik)
GUNLER=(x Pazartesi Sali Carsamba Persembe Cuma Cumartesi Pazar)
gun()       { local g a h; read -r g a h < <(date -d @"$1" '+%-d %-m %u'); echo "$g ${AYLAR[$a]} ${GUNLER[$h]}"; }   # 2 Kasim Pazartesi
tarih()     { local g a s; read -r g a s < <(date -d @"$1" '+%-d %-m %H:%M'); echo "$g ${AYLAR[$a]} $s"; }      # 4 Kasim 14:42
simdi()     { date +%s; }
onay()      { local c; read -r -p "Onayliyor musun? (evet yaz): " c; [ "$c" = "evet" ] || { echo "Iptal edildi."; exit 0; }; }
evet_mi()   { case "${1,,}" in evet|yes|true|1) return 0;; *) return 1;; esac; }

ek_dosya()  { echo "$DIR/ek-$(date +%F)"; }   # bugun alinan molalarin toplami
plan_modu() { [ -f "$PLAN" ] && cat "$PLAN" || echo ""; }
plan_gunleri() { case "$1" in hafta) echo "$HAFTA_GUNLER";; full) echo "$FULL_GUNLER";; esac; }
gun_adlari() {
  local g ad=(x Pzt Sal Car Per Cum Cmt Paz) cikti=""
  for g in $1; do [[ "$g" =~ ^[1-7]$ ]] && cikti+="${ad[$g]} "; done
  echo "${cikti% }"
}
plan_adi()  { echo "$1 ($(gun_adlari "$(plan_gunleri "$1")"))"; }

plan_bitis_bugun() {
  local b ek=0
  b=$(date -d "today $PLAN_BIT" +%s)
  [ -f "$(ek_dosya)" ] && ek=$(cat "$(ek_dosya)")
  echo $(( b + ek ))
}

duraklatildi() { [ -f "$ARA" ] && [ "$(simdi)" -lt "$(cat "$ARA")" ]; }
plan_bekliyor() { [ -f "$PLAN_BASLANGIC" ] && [ "$(simdi)" -lt "$(cat "$PLAN_BASLANGIC")" ]; }
# Ileri tarihli plan baslamadan kapatma/duraklatma/gevsetme istegi gonderilemez
baslamadan_gevsetme_yok() {
  plan_bekliyor || return 0
  echo "Plan $(gun "$(cat "$PLAN_BASLANGIC")") gunu baslayacak. Baslamadan kapatma, duraklatma ya da gevsetme istegi gonderilemez."
  exit 1
}
elle_aktif()   { [ -f "$BITIS" ] && [ "$(simdi)" -lt "$(cat "$BITIS")" ]; }
molada()       { [ -f "$MOLA" ] && [ "$(simdi)" -lt "$(cat "$MOLA")" ]; }

plan_aktif() {
  local mod n
  mod=$(plan_modu); [ -n "$mod" ] || return 1
  plan_bekliyor && return 1
  duraklatildi && return 1
  [[ " $(plan_gunleri "$mod") " == *" $(date +%u) "* ]] || return 1
  n=$(simdi)
  [ "$n" -ge "$(date -d "today $PLAN_BAS" +%s)" ] && [ "$n" -lt "$(plan_bitis_bugun)" ]
}
aktif() { elle_aktif || plan_aktif; }

engel_listesi() {
  printf '  - %s\n' "${SITELER[@]}"
  mac && echo "  - (macOS: siteler /etc/hosts ile engellenir)"
  evet_mi "$YT_ABONELIK_ENGELLE" && echo "  - $YT_YOL"
  ! mac && echo "  - Gizli pencere ve Tor penceresi"
  if [ -f "$EKLENTI_DIR/odak-yt.crx" ] || mac; then echo "  - YouTube: izin listesi disindaki kanallar ve Shorts"; fi
  mac && echo "  - Brave, YouTube eklentisi yuklu ve acik degilse kapatilir"
  evet_mi "$TAILSCALE_ENGELLE" && echo "  - Tailscale uzerinden butun baglantilar"
  [ "${#ENGELLI_IPLER[@]}" -gt 0 ] && echo "  - Su adreslere baglanti: ${ENGELLI_IPLER[*]}"
  [ "${#UYGULAMALAR[@]}" -gt 0 ] && echo "  - Kapatilan uygulamalar: ${UYGULAMALAR[*]}"
  return 0
}

# ---------- YouTube eklentisi ----------
kanal_listesi() {
  if [ -f "$KANALLAR" ]; then grep -v '^[[:space:]]*#' "$KANALLAR" | grep -v '^[[:space:]]*$'
  else printf '%s\n' "${VARSAYILAN_KANALLAR[@]}"; fi
}

# aktif=true: sadece izinli kanallar oynar; false: eklenti bekler. Dosya hep yerinde kalir,
# yoksa tarayici eklentiyi kaldirir. Icerik degismediyse yazmaz.
eklenti_yaz() {
  local durum="$1" kl="" k d f icerik ab=false
  while IFS= read -r k; do kl+="\"$k\","; done < <(kanal_listesi)
  if mac; then
    [ -f "$MAC_EKLENTI/manifest.json" ] || return 0
    evet_mi "$YT_ABONELIK_ENGELLE" && ab=true
    icerik=$(printf '{ "aktif": %s, "abonelik": %s, "kanallar": [%s] }' "$durum" "$ab" "${kl%,}")
    f="$MAC_EKLENTI/durum.json"
    [ -f "$f" ] && [ "$(cat "$f")" = "$icerik" ] && return 0
    echo "$icerik" > "$f.yeni" && chmod 644 "$f.yeni" && mv -f "$f.yeni" "$f"
    return 0
  fi
  [ -f "$EKLENTI_DIR/odak-yt.crx" ] || return 0
  icerik=$(printf '{ "ExtensionInstallForcelist": ["%s;file://%s/updates.xml"], "3rdparty": { "extensions": { "%s": { "aktif": %s, "kanallar": [%s] } } } }' \
    "$EKLENTI_ID" "$EKLENTI_DIR" "$EKLENTI_ID" "$durum" "${kl%,}")
  for d in "${CHROMIUM_DIRLER[@]}"; do
    mkdir -p "$d"; f="$d/odak-eklenti.json"
    [ -f "$f" ] && [ "$(cat "$f")" = "$icerik" ] && continue
    kilit_ac "$f"; echo "$icerik" > "$f"; kilitle "$f"
  done
}

kanal() {
  local islem="${1:-}" k="${2:-}"
  if [ -z "$islem" ]; then echo "YouTube izin listesi:"; kanal_listesi | sed 's/^/  /'; return; fi
  [ "$islem" = ekle ] || [ "$islem" = sil ] || { echo "Kullanim: odak kanal | odak kanal ekle @kanal | odak kanal sil @kanal"; exit 1; }
  if aktif; then echo "Odak sirasinda (mola dahil) izin listesi degistirilemez."; exit 1; fi
  k=$(echo "$k" | sed -E 's#^https?://(www\.|m\.)?youtube\.com/##; s#[/?].*$##')
  [[ "$k" =~ ^@[A-Za-z0-9._-]{3,30}$ ]] || { echo "Kanali @adi seklinde yaz (ornek: odak kanal ekle @3blue1brown)."; exit 1; }
  kanallari_hazirla
  kilit_ac "$KANALLAR"
  if [ "$islem" = ekle ]; then
    if grep -qixF "$k" "$KANALLAR"; then echo "Zaten listede: $k"; else echo "$k" >> "$KANALLAR"; echo "Eklendi: $k"; fi
  else
    if grep -qixF "$k" "$KANALLAR"; then grep -vixF "$k" "$KANALLAR" > "$KANALLAR.yeni"; mv -f "$KANALLAR.yeni" "$KANALLAR"; echo "Silindi: $k"
    else echo "Listede yok: $k"; fi
  fi
  kilitle "$KANALLAR"
  eklenti_yaz false
}

kanallari_hazirla() {
  mkdir -p "$DIR"
  [ -f "$KANALLAR" ] && return
  { echo "# odak kanal ekle/sil ile duzenle"; printf '%s\n' "${VARSAYILAN_KANALLAR[@]}"; } > "$KANALLAR"
  kilitle "$KANALLAR"
}

# ---------- macOS: eklenti, Brave bekcisi, profil ----------
# Paketteki eklentiyi $MAC_EKLENTI'ye kopyalar (sadece degistiyse). Brave bu klasoru okur.
mac_eklenti_kopyala() {
  local f degisti=""
  [ -d "$MAC_EKLENTI_KAYNAK" ] || return 0
  mkdir -p "$MAC_EKLENTI"
  for f in "$MAC_EKLENTI_KAYNAK"/*; do
    [ -f "$f" ] || continue
    cmp -s "$f" "$MAC_EKLENTI/$(basename "$f")" && continue
    cp -f "$f" "$MAC_EKLENTI/"; degisti=1
  done
  chmod 755 "$DIR" "$MAC_EKLENTI"; chmod 644 "$MAC_EKLENTI"/*
  [ -n "$degisti" ] && logger "concentra: eklenti dosyalari guncellendi"
  return 0
}

konsol_kullanici() { local u; u=$(/usr/bin/stat -f %Su /dev/console 2>/dev/null); [ -n "$u" ] && [ "$u" != root ] && echo "$u"; }

# Bir Brave profilinde eklentinin durumu: tamam | yok | kapali | baska-klasor
brave_profil_durumu() {
  local p="$1" f c sonuc=yok
  for f in "$p/Secure Preferences" "$p/Preferences"; do
    [ -f "$f" ] || continue
    c=$(jq -r --arg id "$EKLENTI_ID" '
      .extensions.settings[$id] // empty
      | if ((.disable_reasons // 0) | if type == "array" then length > 0 else . != 0 end) or (.state == 0)
        then "kapali" else (.path // "") end' "$f" 2>/dev/null) || continue
    [ -n "$c" ] || continue
    case "$c" in
      kapali) sonuc=kapali ;;
      "$MAC_EKLENTI"|"$MAC_EKLENTI/"|"/private$MAC_EKLENTI"|"/private$MAC_EKLENTI/") echo tamam; return ;;
      *) sonuc=baska-klasor ;;
    esac
  done
  echo "$sonuc"
}

# Kullanicinin butun Brave profillerinde eklenti tamam mi? Degilse sorunlu profili yazar.
brave_eklenti_durumu() {
  local ev="$1" kok p d bulundu=""
  kok="$ev/Library/Application Support/BraveSoftware/Brave-Browser"
  [ -d "$kok" ] || { echo "brave-yok"; return; }
  for p in "$kok"/Default "$kok"/Profile\ *; do
    [ -f "$p/Preferences" ] || continue
    bulundu=1
    d=$(brave_profil_durumu "$p")
    [ "$d" = tamam ] || { echo "$d $(basename "$p")"; return; }
  done
  [ -n "$bulundu" ] && echo tamam || echo "yok Default"
}

bildir() {   # ekrandaki kullaniciya bildirim gosterir
  local u
  u=$(konsol_kullanici) || return 0
  launchctl asuser "$(id -u "$u")" sudo -u "$u" osascript -e "display notification \"$1\" with title \"concentra\"" >/dev/null 2>&1 || true
}

# Odak sirasinda: Brave aciksa ve eklenti her profilde yuklu/acik degilse Brave'i kapat
brave_bekci() {
  local u ev d
  pgrep -x "$BRAVE_SUREC" >/dev/null || return 0
  u=$(konsol_kullanici) || return 0
  ev=$(dscl . -read "/Users/$u" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  [ -n "$ev" ] || return 0
  d=$(brave_eklenti_durumu "$ev")
  case "$d" in tamam|brave-yok) return 0 ;; esac
  pkill -x "$BRAVE_SUREC" 2>/dev/null || true
  logger "concentra: Brave kapatildi (YouTube eklentisi: $d)"
  bildir "Brave kapatildi: YouTube eklentisi yuklu ya da acik degil. Kurulum: odak eklenti"
}

