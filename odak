eklenti_komutu() {
  mac || { echo "Linux'ta eklenti politika ile kendiliginden kurulur."; return; }
  local u ev d
  mac_eklenti_yardim
  echo
  u=$(konsol_kullanici) && ev=$(dscl . -read "/Users/$u" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  if [ -n "${ev:-}" ]; then
    d=$(brave_eklenti_durumu "$ev")
    case "$d" in
      tamam)        echo "Durum: eklenti butun Brave profillerinde yuklu ve acik." ;;
      brave-yok)    echo "Durum: Brave bulunamadi." ;;
      kapali*)      echo "Durum: eklenti yuklu ama kapali (${d#* } profili)." ;;
      baska-klasor*) echo "Durum: eklenti baska bir klasorden yuklenmis (${d#* } profili). $MAC_EKLENTI'den yukle." ;;
      *)            echo "Durum: eklenti yuklu degil (${d#* } profili)." ;;
    esac
