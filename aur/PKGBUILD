# Maintainer: Noarex <https://github.com/Noarex>
pkgname=concentra
pkgver=1.2.0
pkgrel=1
pkgdesc="Planli odak modu: siteleri, uygulamalari ve YouTube'u (kanal izin listesiyle) engeller"
arch=('any')
url="https://github.com/Noarex/concentra"
license=('MIT')
depends=('bash' 'sudo' 'nftables' 'e2fsprogs' 'procps-ng' 'gawk' 'sed' 'grep' 'coreutils' 'systemd')
makedepends=('git')
optdepends=('brave-bin: YouTube kanal izin listesi eklentisi'
            'chromium: YouTube kanal izin listesi eklentisi'
            'firefox: site engelleri (YouTube eklentisi yok)')
backup=('etc/concentra.conf')
install=concentra.install
_eklenti=1.0.0   # eklenti (crx) surumu; sadece eklenti degisince artar
_commit=017b5bdefd0344e6fdb011e9989b41b1b2840f33   # bu surumun kodu
source=("$pkgname::git+https://github.com/Noarex/concentra.git#commit=$_commit"
        "odak-yt-$_eklenti.crx::https://github.com/Noarex/concentra/releases/download/v$_eklenti/odak-yt.crx")
sha256sums=('SKIP'
            '9852b8bcdce5b43ef37684de8167e02d50a76d32ffc291bd20d994e788dc3347')

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 odak "$pkgdir/usr/bin/odak"
  ln -s odak "$pkgdir/usr/bin/concentra"
  install -Dm644 concentra.conf "$pkgdir/etc/concentra.conf"
  install -dm755 "$pkgdir/etc/concentra.d"
  install -Dm644 systemd/concentra.service "$pkgdir/usr/lib/systemd/system/concentra.service"
  install -Dm644 systemd/concentra.timer "$pkgdir/usr/lib/systemd/system/concentra.timer"
  install -Dm644 eklenti/updates.xml "$pkgdir/usr/share/concentra/updates.xml"
  install -Dm644 "$srcdir/odak-yt-$_eklenti.crx" "$pkgdir/usr/share/concentra/odak-yt.crx"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
