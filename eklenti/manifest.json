{
  "manifest_version": 3,
  "name": "Odak YouTube",
  "version": "1.1",
  "description": "Odak modunda sadece izin verilen kanallarin videolarini oynatir.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
